---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Minimalist Others" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WD5BB9J40J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WD5BB9J40J');
    </script>
  </head>
  <body>
    <div class="layout-container">
      <div class="sidebar-wrapper">
        <ul class="nav-list">
          <slot />
        </ul>
      </div>
    </div>
  </body>
</html>

<style is:global>
  html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: white;
    font-family: Consolas, 'Courier New', monospace;
    color: black;
    font-size: 13px;
  }
  a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  a:hover {
    text-decoration: none;
    opacity: 0.8;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>

<style>
  /* Misma rejilla y offsets que Layout.astro (página principal) */
  .layout-container {
    display: grid;
    grid-template-columns: 200px 1fr 150px;
    min-height: 100vh;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px;
    gap: 40px;
  }

  .sidebar-wrapper {
    position: relative;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    font-size: 13px;
    margin-top: 120px;
    margin-left: 60px;
    list-style: none;
    padding: 0;
    margin-bottom: 0;
  }

  .nav-list :global(li) {
    margin-bottom: 2px;
    list-style: none;
  }

  @media (max-width: 1024px) {
    .layout-container {
      grid-template-columns: 160px 1fr 100px;
      padding: 20px;
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .layout-container {
      display: flex;
      flex-direction: column;
      padding: 20px;
      gap: 20px;
    }

    .nav-list {
      margin-top: 80px;
      margin-left: 24px;
    }
  }
</style>
