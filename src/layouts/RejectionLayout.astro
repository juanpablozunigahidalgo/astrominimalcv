---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Fictional job rejections" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WD5BB9J40J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WD5BB9J40J');
    </script>
  </head>
  <body>
    <div class="layout-container">
      <div class="sidebar-wrapper">
        <div class="page-anchor">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: white;
    font-family: Consolas, 'Courier New', monospace;
    color: black;
    font-size: 13px;
  }
  a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  a:hover {
    text-decoration: none;
    opacity: 0.8;
  }
</style>

<style>
  .layout-container {
    display: grid;
    grid-template-columns: 200px 1fr 150px;
    min-height: 100vh;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px;
    gap: 40px;
  }

  .sidebar-wrapper {
    position: relative;
  }

  .page-anchor {
    margin-top: 120px;
    margin-left: 60px;
    max-width: 52rem;
  }

  .page-anchor :global(.page-title) {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: normal;
  }

  .page-anchor :global(.page-note) {
    margin: 0 0 16px;
    opacity: 0.7;
    line-height: 1.4;
  }

  .page-anchor :global(.rejection-status) {
    margin: 0 0 12px;
    opacity: 0.6;
  }

  .page-anchor :global(.rejection-feed) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .page-anchor :global(.rejection-letter) {
    margin: 0;
    padding: 0 0 24px;
    border-bottom: 1px solid #e8e8e8;
  }

  .page-anchor :global(.rejection-meta) {
    margin: 0 0 8px;
    opacity: 0.75;
  }

  .page-anchor :global(.rejection-body) {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.45;
  }

  @media (max-width: 1024px) {
    .layout-container {
      grid-template-columns: 160px 1fr 100px;
      padding: 20px;
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .layout-container {
      display: flex;
      flex-direction: column;
      padding: 20px;
      gap: 20px;
    }

    .page-anchor {
      margin-top: 80px;
      margin-left: 24px;
    }
  }
</style>
