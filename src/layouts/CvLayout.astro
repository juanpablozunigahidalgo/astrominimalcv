---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Minimalist CV" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WD5BB9J40J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WD5BB9J40J');
    </script>
  </head>
  <body>
    <main class="cv-only-layout">
      <slot />
    </main>
  </body>
  </html>

<style is:global>
  html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: white;
    font-family: Consolas, 'Courier New', monospace;
    color: black;
    font-size: 13px;
  }
</style>

<style>
  /* Starts where the "CV" link sits on the landing page (Layout.astro: container padding + nav margins). */
  .cv-only-layout {
    width: 60%;
    margin: 160px 0 110px calc(max(0px, (100% - 1480px) / 2) + 100px);
    line-height: 1.6;
    text-align: left;
  }

  @media (max-width: 1024px) {
    .cv-only-layout {
      margin-left: 80px;
    }
  }

  @media (max-width: 768px) {
    .cv-only-layout {
      width: auto;
      margin: 100px 44px 60px;
    }
  }
</style>
