---
import OthersLayout from '../layouts/OthersLayout.astro';
import projectsList from '../data/others-links.json';

const basePrefix = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

function projectHref(url: string): string {
  if (url.startsWith('http')) return url;
  return `${basePrefix}${url.startsWith('/') ? url : `/${url}`}`;
}
---

<OthersLayout title="Other">
  {projectsList.map((project) => {
    const href = projectHref(project.url);
    const external = project.url.startsWith('http');
    return (
      <li>
        <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
          {project.name}
        </a>
      </li>
    );
  })}
</OthersLayout>
