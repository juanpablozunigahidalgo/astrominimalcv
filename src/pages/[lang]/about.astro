---
import AboutLayout from '../../layouts/AboutLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('general');
  return pages.map(page => ({
    params: { lang: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const textAbout = page.data["text-about"];
const paragraphs = Array.isArray(textAbout) ? textAbout : [textAbout];
---

<AboutLayout title="About">
  {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
</AboutLayout>

<style></style>
