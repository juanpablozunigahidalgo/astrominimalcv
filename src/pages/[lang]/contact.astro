---
import ContactLayout from '../../layouts/ContactLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('general');
  return pages.map(page => ({
    params: { lang: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { contactdata } = page.data;
---

<ContactLayout title="Contact">
  <li>{contactdata.email}</li>
  <li><a href={contactdata.linkedin} target="_blank">{contactdata.linkedin}</a></li>
  <li><a href={contactdata.github} target="_blank">{contactdata.github}</a></li>
</ContactLayout>
